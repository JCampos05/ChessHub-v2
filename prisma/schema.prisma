generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ScopeType {
  FEDERATION
  STATE
  MUNICIPALITY
  TOURNAMENT

  @@map("scope_type")
}

enum PlayerStatus {
  PENDING
  ACTIVE
  INACTIVE

  @@map("player_status")
}

enum AccessEvent {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  ACCOUNT_LOCKED
  REFRESH
  REFRESH_REUSE
  LOGOUT

  @@map("access_event")
}

model User {
  id                  String    @id @default(uuid(7)) @db.Uuid
  email               String    @unique
  passwordHash        String    @map("password_hash")
  fullName            String?   @map("full_name")
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles      UserRole[]
  sessions   Session[]
  accessLogs AccessLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users UserRole[]

  @@map("roles")
}

model UserRole {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  scopeType    ScopeType @map("scope_type")
  scopeId      String?   @map("scope_id") @db.Uuid
  note         String?
  assignedById String?   @map("assigned_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  device           String?
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?   @map("revoked_reason")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@map("sessions")
}

model AccessLog {
  id             String      @id @default(uuid(7)) @db.Uuid
  event          AccessEvent
  userId         String?     @map("user_id") @db.Uuid
  emailAttempted String?     @map("email_attempted")
  ipAddress      String?     @map("ip_address")
  userAgent      String?     @map("user_agent")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("access_logs")
}

model Player {
  id             String       @id @default(uuid(7)) @db.Uuid
  fullName       String       @map("full_name")
  normalizedName String       @map("normalized_name")
  nameKey        String       @map("name_key")
  birthDate      DateTime?    @map("birth_date") @db.Date
  sex            String?
  federation     String       @default("MEX")
  fideId         String?      @unique @map("fide_id")
  nationalId     String?      @unique @map("national_id")
  clubCode       String?      @map("club_code")
  email          String?
  phone          String?
  status         PlayerStatus @default(PENDING)
  kFactor        Int?         @map("k_factor")
  ratingElo      Decimal?     @map("rating_elo") @db.Decimal(6, 1)
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  whitePairings Pairing[] @relation("PairingWhite")
  blackPairings Pairing[] @relation("PairingBlack")
  whiteGames    Game[]    @relation("GameWhite")
  blackGames    Game[]    @relation("GameBlack")

  @@unique([nameKey, birthDate])
  @@index([nameKey])
  @@index([normalizedName])
  @@index([ratingElo, fideId])
  @@index([clubCode])
  @@map("players")
}

enum TournamentStatus {
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  ROUND_IN_PROGRESS
  FINISHED
  CANCELLED

  @@map("tournament_status")
}

enum RoundStatus {
  PENDING
  IN_PROGRESS
  FINISHED

  @@map("round_status")
}

enum GameResult {
  PENDING
  WHITE_WINS
  BLACK_WINS
  DRAW

  @@map("game_result")
}

model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  description String?
  minAge      Int?     @map("min_age")
  maxAge      Int?     @map("max_age")
  defaultCost Decimal  @default(0) @map("default_cost") @db.Decimal(10, 2)
  usesElo     Boolean  @default(false) @map("uses_elo")
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tournaments TournamentCategory[]

  @@map("categories")
}

model Tournament {
  id           String           @id @default(uuid(7)) @db.Uuid
  name         String
  description  String?
  venue        String?
  city         String?
  startDate    DateTime         @map("start_date") @db.Date
  endDate      DateTime         @map("end_date") @db.Date
  roundsPlanned Int?            @map("rounds_planned")
  maxPlayers   Int?             @map("max_players")
  timeControl  String?          @map("time_control")
  status       TournamentStatus @default(REGISTRATION_OPEN)
  isActive     Boolean          @default(true) @map("is_active")
  createdById  String?          @map("created_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  categories TournamentCategory[]
  rounds     Round[]

  @@index([startDate])
  @@index([status, startDate])
  @@map("tournaments")
}

model TournamentCategory {
  tournamentId String   @map("tournament_id") @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([tournamentId, categoryId])
  @@index([categoryId])
  @@map("tournament_categories")
}

model Round {
  id           String      @id @default(uuid(7)) @db.Uuid
  tournamentId String      @map("tournament_id") @db.Uuid
  number       Int
  status       RoundStatus @default(PENDING)
  startedAt    DateTime?   @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?   @map("finished_at") @db.Timestamptz(3)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  pairings   Pairing[]
  games      Game[]

  @@unique([tournamentId, number])
  @@map("rounds")
}

model Pairing {
  id            String   @id @default(uuid(7)) @db.Uuid
  tournamentId  String   @map("tournament_id") @db.Uuid
  roundNumber   Int      @map("round_number")
  board         Int
  whitePlayerId String   @map("white_player_id") @db.Uuid
  blackPlayerId String?  @map("black_player_id") @db.Uuid
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  round Round   @relation(fields: [tournamentId, roundNumber], references: [tournamentId, number], onDelete: Restrict)
  white Player  @relation("PairingWhite", fields: [whitePlayerId], references: [id], onDelete: Restrict)
  black Player? @relation("PairingBlack", fields: [blackPlayerId], references: [id], onDelete: Restrict)
  game  Game?

  @@unique([tournamentId, roundNumber, board])
  @@unique([tournamentId, roundNumber, whitePlayerId])
  @@unique([tournamentId, roundNumber, blackPlayerId])
  @@index([whitePlayerId])
  @@index([blackPlayerId])
  @@map("pairings")
}

model Game {
  id            String     @id @default(uuid(7)) @db.Uuid
  tournamentId  String     @map("tournament_id") @db.Uuid
  roundNumber   Int        @map("round_number")
  pairingId     String?    @unique @map("pairing_id") @db.Uuid
  whitePlayerId String     @map("white_player_id") @db.Uuid
  blackPlayerId String     @map("black_player_id") @db.Uuid
  result        GameResult @default(PENDING)
  pgn           String?
  playedAt      DateTime?  @map("played_at") @db.Timestamptz(3)
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  round   Round    @relation(fields: [tournamentId, roundNumber], references: [tournamentId, number], onDelete: Restrict)
  pairing Pairing? @relation(fields: [pairingId], references: [id], onDelete: Restrict)
  white   Player   @relation("GameWhite", fields: [whitePlayerId], references: [id], onDelete: Restrict)
  black   Player   @relation("GameBlack", fields: [blackPlayerId], references: [id], onDelete: Restrict)

  @@index([tournamentId, roundNumber])
  @@index([whitePlayerId])
  @@index([blackPlayerId])
  @@map("games")
}
